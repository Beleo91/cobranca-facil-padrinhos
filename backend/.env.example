# ============================================================
# Cobrança Fácil Padrinhos — Variáveis de Ambiente (Exemplo)
# ============================================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NO RENDER.COM: Configure estas variáveis no painel de Environment.
# ============================================================

# --- Administrador do Sistema ---
# E-mail e senha do usuário admin master, criado/sincronizado automaticamente no startup.
# Altere ADMIN_PASSWORD no painel do Render e faça redeploy para trocar a senha.
ADMIN_EMAIL=seuemail@gmail.com
ADMIN_PASSWORD=SuaSenhaSegura@2026!

# --- Gateway Asaas (obter em https://www.asaas.com/developerConfig) ---
ASSAAS_API_KEY=sua_api_key_do_asaas_aqui
ASAAS_PIX_KEY=sua_chave_pix_do_asaas_aqui
ASAAS_BASE_URL=https://www.asaas.com/api/v3

# --- Segurança JWT (gerar random: python -c "import secrets; print(secrets.token_hex(32))") ---
SECRET_KEY=gere-uma-chave-aleatoria-segura-de-64-chars-minimo
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Ambiente ---
# development | production
ENVIRONMENT=production

# --- URL Pública da Aplicação ---
# Usada nos links dos e-mails de recuperação de senha
APP_URL=https://cobranca-facil-padrinhos.onrender.com

# --- E-mail SMTP (Recuperação de Senha) ---
# Use SMTP do Gmail com Senha de Aplicativo (recomendado):
#   1. Ative a verificação em 2 etapas na conta Google
#   2. Vá em myaccount.google.com/apppasswords e gere uma senha de app
#   3. Use essa senha gerada como SMTP_PASSWORD
# Se não configurar o SMTP, o link de recuperação será impresso nos logs do Render.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASSWORD=sua-senha-de-aplicativo-do-gmail
